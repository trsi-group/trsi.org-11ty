---
pagination:
  data: cms
  size: 100

layout: layouts/base.liquid
title: Productions
tags: page
---
    <section class="section section--page">
      <div class="page-header">
        <h1 class="page-header__title">Our <span class="text-accent">Productions</span></h1>
        <p class="page-header__lede">Demos, intros and cracktros from more than three decades on Amiga, C64, PC and console.</p>
      </div>
      <div class="filter-bar">
        <span class="filter-bar__label">{%- include "icons/filter.svg" %} Filter</span>
        <div class="filter-bar__group">
          <button type="button" class="filter-reset" id="filter-reset" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Reset filter
          </button>
          {%- render "components/feed-filter.liquid", feed: cms.productions, type: "Platform" %}
          {%- render "components/feed-filter.liquid", feed: cms.productions, type: "Type" %}
        </div>
      </div>
      <div id="feed-wrapper">
        {%- render "components/card-grid.liquid", feed: cms.productions, kind: "productions" %}
      </div>
    </section>

    <div class="modal-wrapper">
      {%- render "components/modal-template.liquid" %}
    </div>
