---
pagination:
  data: cms.posts   # Array of posts
  size: 1           # One page per post
  alias: post       # Each item will be called 'post'
permalink: "news/{{ post.slug }}/index.html"
layout: layouts/base.liquid
title: TRSI News - {{ post.title }}
---
<section class="section">
  <div class="section__inner">
    <article class="article">
      {%- if post.publishDate %}
      <p class="article__date"><time datetime="{{ post.publishDate | isoDate }}">{{ post.publishDate | displayDate }}</time></p>
      {%- endif %}
      <h1 class="article__title">{{ post.title }}</h1>
      <div class="article__body">
        {{ post.body | markdown }}
      </div>
    </article>
  </div>
</section>

<section class="section section--alt" aria-labelledby="h-other-posts">
  <div class="section__inner">
    {%- render "components/section-head.liquid", title: "Other Posts", id: "h-other-posts", more_url: "/news/", more_label: "Show all news" %}
    {%- render "components/feed-news.liquid", feed: cms.posts, max: 3 %}
  </div>
</section>
