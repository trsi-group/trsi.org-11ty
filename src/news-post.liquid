---
pagination:
  data: cms.posts   # Array of posts
  size: 1           # One page per post
  alias: post       # Each item will be called 'post'
permalink: "news/{{ post.slug }}/index.html"
layout: layouts/base.liquid
nav_section: news
eleventyComputed:
  title: "{{ post.title }}"
---
    <section class="section section--page">
      <div class="section__narrow">
        <div class="page-header">
          <div class="section__label">News</div>
          <h1 class="page-header__title">{{ post.title }}</h1>
          <p class="page-header__lede">
            {{ post.publishDate | date: "%B %-d, %Y" }}
            {%- if post.author %} &middot; {{ post.author }}{% endif %}
          </p>
        </div>

        <div class="prose">
          {{ post.body | markdown }}
        </div>
      </div>
    </section>

    <section class="section section--rule">
      <div class="section__label">More News</div>
      {%- render "components/card-grid.liquid", feed: cms.posts, kind: "posts", max: 3, exclude: post.slug %}
      <div class="section__more">
        <a href="/news/" class="btn btn--outline">All news &rarr;</a>
      </div>
    </section>
