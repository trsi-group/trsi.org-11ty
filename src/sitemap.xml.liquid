---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: null
---
{%- comment %} A section marked `hidden` in navdata is not being promoted yet, so
it stays out of the sitemap as well as out of the nav: its listing page, its item
pages and — for news — its posts. The lowercased nav title is the section slug,
the same match the header makes against a page. {% endcomment %}
{%- assign hidden_sections = navdata.nav_items | where: "hidden", true | map: "title" | join: "," | downcase | split: "," -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in collections.page %}
    {%- assign page_section = page.url | remove_first: "/" | split: "/" | first %}
    {%- unless page.url == '/404.html' or hidden_sections contains page_section %}
  <url>
    <loc>{{ site.domain }}{{ page.url | url_decode }}</loc>
    <lastmod>{{ page.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>daily</changefreq>
  </url>
    {%- endunless %}
  {%- endfor %}
  {%- unless hidden_sections contains "news" %}
  {%- for post in cms.posts %}
  <url>
    <loc>{{ site.domain }}/news/{{ post.slug | url_decode }}/</loc>
    {%- if post.publishDate != blank %}
    <lastmod>{{ post.publishDate | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
  </url>
  {%- endfor %}
  {%- endunless %}
{%- comment %} Item pages describe a fixed release, so they carry the release date
and no changefreq rather than inheriting the daily one above. {% endcomment %}
  {%- assign item_feeds = "productions,graphics,music" | split: "," %}
  {%- for feed_name in item_feeds %}
    {%- unless hidden_sections contains feed_name %}
    {%- assign feed = cms[feed_name] %}
    {%- for item in feed %}
  <url>
    <loc>{{ site.domain }}/{{ feed_name }}/{{ item.slug | url_decode }}/</loc>
      {%- if item.release_date != blank %}
    <lastmod>{{ item.release_date | date: "%Y-%m-%d" }}</lastmod>
      {%- endif %}
  </url>
    {%- endfor %}
    {%- endunless %}
  {%- endfor %}
</urlset>
