{%- comment %} Structured data for one production, graphic or track. Every string
goes through `jsonify`, which quotes and escapes it, so CMS prose cannot break
the document. {% endcomment %}
{%- if item_kind == "music" %}{%- assign creator_key = "byArtist" %}{%- else %}{%- assign creator_key = "creator" %}{%- endif %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
    {%- case item_kind %}
      {%- when "productions" %}
      "@type": "VideoObject",
      "embedUrl": {{ item.youtube | jsonify }},
      "thumbnailUrl": {{ item.social_image | prepend: site.domain | jsonify }},
      {%- if item.release_date %}
      "uploadDate": {{ item.release_date | date: "%Y-%m-%d" | jsonify }},
      {%- endif %}
      {%- when "graphics" %}
      "@type": "VisualArtwork",
      "image": {{ item.social_image | prepend: site.domain | jsonify }},
      {%- if item.type %}
      "artform": {{ item.type | jsonify }},
      {%- endif %}
      {%- if item.release_date %}
      "dateCreated": {{ item.release_date | date: "%Y-%m-%d" | jsonify }},
      {%- endif %}
      {%- when "music" %}
      "@type": "MusicRecording",
      "image": {{ item.social_image | prepend: site.domain | jsonify }},
      {%- if item.type %}
      "genre": {{ item.type | jsonify }},
      {%- endif %}
      {%- if item.release_date %}
      "datePublished": {{ item.release_date | date: "%Y-%m-%d" | jsonify }},
      {%- endif %}
    {%- endcase %}
      "name": {{ item.title | jsonify }},
      "description": {{ item.description | default: "" | jsonify }},
      "url": {{ page.url | prepend: site.domain | jsonify }},
      "{{ creator_key }}": [
      {%- for credit in item.credits %}
        { "@type": "Person", "name": {{ credit.name | jsonify }} }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
      ],
      "publisher": {
        "@type": "Organization",
        "name": "Tristar & Red Sector Inc.",
        "url": {{ site.domain | jsonify }}
      }
    }
    </script>
