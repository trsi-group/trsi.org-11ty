<header class="site-header">
  <div class="site-header__inner section__inner">
    <a class="site-header__brand" href="/" aria-label="TRSI — home">
      <img src="/img/trsi-logo-header.webp" alt="" width="97" height="64">
    </a>

    <button type="button" class="navbar-burger" aria-label="Menu" aria-expanded="false" data-target="navMenu">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <div class="site-nav" id="navMenu">
      <nav class="site-nav__list" aria-label="Main">
        {%- for item in nav.nav_items %}
        {%- assign prefix = item.url | append: "/" %}
        {%- assign is_current = false %}
        {%- if item.url == "/" %}
          {%- if page.url == "/" %}{% assign is_current = true %}{% endif %}
        {%- elsif page.url contains prefix %}
          {%- assign is_current = true %}
        {%- endif %}
        <a href="{{ item.url }}" class="site-nav__link{% if is_current %} is-current{% endif %}"{% if is_current %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {%- endfor %}
      </nav>
      {%- render "components/social-links.liquid", social: social, modifier: "site-header__social" %}
    </div>
  </div>
</header>
