    <header class="header">
      <div class="header__inner">
        <a href="/" class="header__logo" aria-label="TRSI — back to the roots">
          <img src="/img/trsi-logo.svg" alt="Tristar &amp; Red Sector" width="116" height="34">
        </a>

        <nav class="header__nav" aria-label="Main navigation">
          <ul class="nav__list" id="nav-list">
          {%- for item in navdata.nav_items %}
            {%- assign item_slug = item.title | downcase %}
            <li{% if item.hidden == true %} class="nav__item--hidden"{% elsif item.mobile_only == true %} class="nav__item--mobile"{% endif %}>
              <a href="{{ item.url }}" class="nav__link{% if page.fileSlug == item_slug %} nav__link--active{% endif %}">{{ item.title }}</a>
            </li>
          {%- endfor %}
            <li class="nav__social">
            {%- assign social_header = social.nav_items | where_exp: "item", "item.locations contains 'header'" %}
            {%- for item in social_header %}
              {%- assign icon_path = "icons/" | append: item.icon | append: ".svg" %}
              <a href="{{ item.url }}" target="_blank" rel="noopener" class="nav__social-link" aria-label="Connect with TRSI on {{ item.name }}">
                {%- include icon_path %}
              </a>
            {%- endfor %}
            </li>
          </ul>

          <button class="nav__toggle" id="nav-toggle" aria-label="Toggle navigation" aria-controls="nav-list" aria-expanded="false">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
        </nav>
      </div>
    </header>
