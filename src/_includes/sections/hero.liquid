    <section class="hero">
      <div class="hero__media" aria-hidden="true">
      {%- for banner in banners %}
        <img class="hero__bg{% if forloop.first %} is-active{% endif %}"
             src="{{ banner.src }}"
             srcset="{{ banner.srcset }}"
             sizes="100vw"
             alt=""
             {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
      {%- endfor %}
      </div>
      <div class="hero__overlay" aria-hidden="true"></div>

      <div class="hero__content">
        <div class="hero__inner">
          <div class="hero__eyebrow">
            <span>Tristar &amp; Red Sector &mdash;</span>
            <span>Demoscene since 1990</span>
          </div>

          <h1 class="hero__headline">The sleeping gods<br>are <span class="text-accent">awake.</span></h1>

          <p class="hero__subtitle">A demo group founded in 1990, born from the union of Tristar and the C64 warez group Red Sector.</p>
          <p class="hero__subtitle">Code, pixels and trackers on Amiga, C64, PC and console &mdash; <span class="text-accent">still shipping.</span></p>

          <div class="hero__actions">
            <a href="/productions/" class="btn btn--primary">Browse Productions</a>
            <a href="/about/" class="btn btn--ghost">Read our story &rarr;</a>
          </div>

          <div class="hero__ticker">
            <div class="hero__ticker-track" style="--ticker-duration: {{ cms.members.size | times: 3.36 | round }}s">
            {%- for pass in (1..2) %}
              <div class="hero__ticker-set"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
              {%- for member in cms.members %}
                <span>{{ member.handle }}</span><span>&middot;</span>
              {%- endfor %}
              </div>
            {%- endfor %}
            </div>
          </div>
        </div>
      </div>
    </section>
