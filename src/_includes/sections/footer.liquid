    <footer class="footer">
      <div class="footer__inner">
        <div class="footer__grid">
          <div class="footer__brand">
            <div class="footer__brand-name">Tristar &amp; Red Sector</div>
            <p class="footer__brand-text">The Sleeping Gods in {{ "now" | date: "%Y" }}</p>
          </div>

          <div>
            <div class="footer__heading">Site</div>
            <div class="footer__links">
              <a href="/">Home</a>
            {%- for item in nav.nav_items %}
              {%- unless item.hidden %}
              <a href="{{ item.url }}">{{ item.title }}</a>
              {%- endunless %}
            {%- endfor %}
              <a href="/about/">About</a>
            {%- for item in legal.links %}
              <a href="{{ item.url }}">{{ item.title }}</a>
            {%- endfor %}
            </div>
          </div>

          <div>
            <div class="footer__heading">Connect</div>
            <div class="footer__links">
            {%- for item in social.nav_items %}
              <a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.name }}</a>
            {%- endfor %}
            </div>
          </div>
        </div>

        <div class="footer__bottom">
          <span>&copy; {{ "now" | date: "%Y" }} Tristar &amp; Red Sector</span>
          <span class="footer__tagline">Back to the roots</span>
        </div>
      </div>
    </footer>
