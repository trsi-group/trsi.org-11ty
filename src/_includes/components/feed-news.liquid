{%- assign items = max | default: feed.size %}
{%- assign sorted_feed = feed | sort: "publishDate" | reverse %}
{%- assign sliced_feed = sorted_feed | slice: 0, items %}
<div class="card-grid">
  {%- for item in sliced_feed %}
  <div class="card-grid__item">
    {%- if forloop.first %}
    {%- render "components/card-news.liquid", item: item, loading: "eager" %}
    {%- else %}
    {%- render "components/card-news.liquid", item: item %}
    {%- endif %}
  </div>
  {%- endfor %}
</div>
