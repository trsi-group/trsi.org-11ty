<article class="card" data-ctype="member">
  <div class="card-image card-image--member">
    <img src="{{ card.card_image }}" alt="{{ card.handle }}" width="800" height="800" loading="lazy" decoding="async">
  </div>
  <div class="card-content">
    <p class="title">{{ card.handle }}</p>
    <p class="subtitle">{{ card.member_status }}</p>
  </div>
</article>
