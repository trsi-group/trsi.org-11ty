<article class="card pointer"
  data-ctype="music"
  {{- if card.title }}data-slug='{{ card.title | slugify }}'{{- endif }}
  {{- if card.download }}data-download='{{ card.download }}'{{- endif }}
  {{- if card.demozoo }}data-demozoo='{{ card.demozoo }}'{{- endif }}
  {{- if card.credits }}data-credits='{{ card.credits | jsonify }}'{{- endif }}
  {{- if card.description }}data-description='{{ card.description }}'{{- endif }}
  {{- if card.release_date }}data-release_date='{{ card.release_date }}'{{- endif }}
  {{- if card.type }}data-format='{{ card.type }}'{{- endif }}
  {{- if card.asset }}data-asset='{{ card.asset }}'{{- endif }}
  {{- if card.playerEmu }}data-playeremu='{{ card.playerEmu }}'{{- endif }}
  {{- if card.kestra }}data-kestra='{{ card.kestra }}'{{- endif }}
  {{- if card.card_image }}data-image='{{ card.card_image }}'{{- endif }}>
  <div class="card-image card-image--player">
    {%- if card.asset %}
    <div class="music-card" data-music-card data-asset="{{ card.asset }}" data-playeremu="{{ card.playerEmu }}" data-title="{{ card.title }}">
      <canvas class="music-card__wave" data-music-wave width="600" height="160" aria-hidden="true"></canvas>
      <div class="music-card__transport">
        <button type="button" class="music-card__btn" data-music-prev aria-label="Previous track">
          {%- include "icons/skip-back.svg" %}
        </button>
        <button type="button" class="music-card__btn music-card__btn--play" data-music-play aria-pressed="false" aria-label="Play {{ card.title }}">
          <span class="music-card__icon--play">{%- include "icons/play.svg" %}</span>
          <span class="music-card__icon--pause">{%- include "icons/pause.svg" %}</span>
        </button>
        <button type="button" class="music-card__btn" data-music-next aria-label="Next track">
          {%- include "icons/skip-forward.svg" %}
        </button>
      </div>
      <p class="music-card__time" data-music-time>0:00 / --:--</p>
    </div>
    {%- else %}
    <img src="{{ card.card_image }}" alt="{{ card.title }}" width="800" height="640" loading="lazy" decoding="async">
    {%- endif %}
  </div>
  <div class="card-content">
    {%- if card.release_date %}
    <p class="card__date"><time datetime="{{ card.release_date | isoDate }}">{{ card.release_date | displayDate }}</time></p>
    {%- endif %}
    <button type="button" class="title card__open">{{ card.title }}</button>
    <p class="subtitle">{% if card.platform %}{{ card.platform }} &ndash; {% endif %}{{ card.type }}</p>
  </div>
</article>
