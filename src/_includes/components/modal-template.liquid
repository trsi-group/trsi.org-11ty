        <div id="modal-overlay" class="modal">
          <div class="modal-background"></div>
          <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="modal__header">
              <div>
                <div id="modal-subtitle" class="modal__kicker"></div>
                <h2 id="modal-title" class="modal__title"></h2>
              </div>
              <button class="modal-close overlay-close" aria-label="Close">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
              </button>
            </div>

            <div class="modal__body">
              <figure class="image modal__media modal__media--video">
                <iframe id="modal-video" src="" title="" frameborder="0" allowfullscreen></iframe>
              </figure>
              <figure class="image modal__media">
                <img id="modal-image" src="" alt="">
                <div id="music-player-overlay" class="music-player-overlay is-hidden">
                  <button id="play-pause-btn" class="music-player-button" aria-label="Play/Pause Music">
                    <span id="play-icon" class="music-player-icon">
                      {%- include "icons/play-button.svg" %}
                    </span>
                    <span id="pause-icon" class="music-player-icon is-hidden">
                      {%- include "icons/pause-button.svg" %}
                    </span>
                  </button>
                </div>
              </figure>
              <div class="modal__details">
                <p id="modal-description" class="modal__description"></p>
                <p id="modal-credits" class="modal__credits"></p>
                <p id="modal-release_date" class="modal__date"></p>
              </div>
            </div>

            <div class="modal__footer">
              <button class="btn btn--outline modal__action">Demozoo</button>
              <button class="btn btn--outline modal__action">CSDB</button>
              <button class="btn btn--outline modal__action">Pouet</button>
              <button class="btn btn--outline modal__action">Download</button>
              <button class="btn btn--outline modal__action">Kestra</button>
            </div>
          </div>
        </div>
