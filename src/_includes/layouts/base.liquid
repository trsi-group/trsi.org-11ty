<!DOCTYPE html>
<html lang="{{ lang | default: 'en' }}">
  <head>
{%- comment %} Pages opt into their own title via `page_title`; without it the site title is used. {% endcomment %}
    <title>{% if page_title %}{{ page_title }} | {{ site.metadata.title }}{% else %}{{ site.metadata.title }}{% endif %}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ post.teaser | default: site.metadata.description }}">
    <meta name="keywords" content="{{ site.metadata.keywords }}">
{% include "sections/og-tags.liquid" %}
    <link rel="canonical" href="{{ site.domain }}{{ page.url  }}">
    {%- if alternate_url %}
    <link rel="alternate" hreflang="{{ lang | default: 'en' }}" href="{{ site.domain }}{{ page.url }}">
    <link rel="alternate" hreflang="{{ alternate_lang }}" href="{{ site.domain }}{{ alternate_url }}">
    {%- endif %}
    {%- if site.prodenv %}
    <link rel="preload" as="style" href="/css/main.min.css">
    <link rel="stylesheet" href="/css/main.min.css">
    {%- else %}
    <link rel="stylesheet" href="/css/index.css">
    {%- endif %}
    <link rel="icon" type="image/png" href="/img/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/img/favicon-48.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/img/favicon-192.png">
    <link rel="apple-touch-icon" type="image/png" sizes="167x167" href="/img/favicon-167.png">
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/img/favicon-180.png">
    <script type="module" src="/js/main.js"></script>
    {%- if page.url contains "/news/" %}
{% include "sections/jsonld-post.liquid" %}
    {% endif %}
{% include "sections/jsonld-organisation.liquid" %}
  </head>
  <body>
{% include "sections/header.liquid" %}
{%- if hero %}
{% include "sections/hero.liquid" %}
{%- endif %}
    <div class="site-container">
{{content}}
    </div>
{% include "sections/footer.liquid" %}
  </body>
</html>
