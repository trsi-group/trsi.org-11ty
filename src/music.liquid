---
pagination:
  data: cms
  size: 100

layout: layouts/base.liquid
title: TRSI Music
---
    <section class="section section--page">
      <div class="page-header">
        <h1 class="page-header__title">Our <span class="text-accent">Music</span></h1>
        <p class="page-header__lede">Tracked music and chiptunes written for our demos, intros and cracktros.</p>
      </div>
      <div class="filter-bar">
        <span class="filter-bar__label">{%- include "icons/filter.svg" %} Filter</span>
        <div class="filter-bar__group">
          {%- render "components/feed-filter.liquid", feed: cms.music, type: "Platform" %}
          {%- render "components/feed-filter.liquid", feed: cms.music, type: "Type" %}
        </div>
      </div>
      <div class="section__label">All Tracks</div>
      <div id="feed-wrapper">
        {%- render "components/card-grid.liquid", feed: cms.music, kind: "music" %}
      </div>
    </section>

    <div class="modal-wrapper">
      {%- render "components/modal-template.liquid" %}
    </div>
