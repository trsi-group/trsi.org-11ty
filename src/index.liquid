---
layout: layouts/base.liquid
tags: page
hero: true
---
{%- assign latest_post = cms.posts | sort: "publishDate" | reverse | first %}
    <section class="section section--rule">
      <div class="section__label">Latest Post</div>
      {%- render "components/latest-post.liquid", post: latest_post %}
    </section>

    <section class="section section--rule">
      <div class="section__label">More News</div>
      {%- render "components/card-grid.liquid", feed: cms.posts, kind: "posts", max: site.homepage.newsItems, exclude: latest_post.slug %}
      <div class="section__more">
        <a href="/news/" class="btn btn--outline">All news &rarr;</a>
      </div>
    </section>

    <section class="section section--rule">
      <div class="section__label">Latest Productions</div>
      {%- render "components/card-grid.liquid", feed: cms.productions, kind: "productions", max: site.homepage.productionItems %}
      <div class="section__more">
        <a href="/productions/" class="btn btn--outline">All productions &rarr;</a>
      </div>
    </section>

    <section class="section section--rule">
      <div class="section__label">Latest Graphics</div>
      {%- render "components/card-grid.liquid", feed: cms.graphics, kind: "graphics", max: site.homepage.graphicsItems %}
      <div class="section__more">
        <a href="/graphics/" class="btn btn--outline">All graphics &rarr;</a>
      </div>
    </section>

    <section class="section">
      <div class="modal-wrapper">
        {%- render "components/modal-template.liquid" %}
      </div>
    </section>
