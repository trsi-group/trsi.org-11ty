{
  "name": "trsi.org-11ty",
  "version": "1.0.0",
  "type": "module",
  "main": "src/main.js",
  "description": "",
  "scripts": {
    "build:c-fetch": "node cms/scripts/fetchContent.js",
    "build:c-process": "node cms/scripts/processContent.js",
    "build:c-verify": "node cms/scripts/checkLegacySlugs.js",
    "build:content": "npm run build:c-fetch && npm run build:c-process && npm run build:c-verify",
    "build:css": "postcss src/css/index.css -o dist/css/main.min.css",
    "build:banners": "node cms/scripts/processBanners.js",
    "build": "npm run build:content && npm run build:banners && npm run build:css && eleventy",
    "start": "npm run build:content && npm run build:banners && npm run build:css && eleventy --serve",
    "serve": "eleventy --serve",
    "debug": "DEBUG=Eleventy* npm run build:content && npm run build:css && eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trsi-group/trsi.org-11ty.git"
  },
  "keywords": [],
  "author": "Madison@TRSI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trsi-group/trsi.org-11ty/issues"
  },
  "homepage": "https://github.com/trsi-group/trsi.org-11ty#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@jgarber/eleventy-plugin-markdown": "^2.0.1",
    "@sindresorhus/slugify": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "contentful": "^11.12.9",
    "contentful-cli": "^4.0.9",
    "contentful-export": "^8.3.0",
    "cssnano": "^9.0.1",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.1",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^17.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@11ty/eleventy-dev-server": "^2.0.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "vitest": "^4.1.11"
  }
}
