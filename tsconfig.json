{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "types/**/*.d.ts",
    "src/_filters/**/*.js",
    "src/_data/**/*.js",
    "src/js/main.js",
    "src/js/utils.js",
    "src/js/heroSlider.js",
    "src/js/cardMusicPlayer.js",
    "src/js/musicPlayer.js",
    "src/js/scriptLoader.js",
    "cms/scripts/**/*.js",
    "tests/**/*.js",
    ".eleventy.js",
    "vitest.config.js",
    "playwright.config.js"
  ]
}
